// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1776967275854578725 @name=steam_app_*
window-rule {
    match app-id="^steam_app_\\d+$"
    open-fullscreen true
}

// @id=wr_1787505298262116641 @name=com.mitchellh.ghostty
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    background-effect {
        blur true
    }
}

// @id=wr_1789135769486715313 @name=deadcells
window-rule {
    match app-id="^deadcells$"
    open-fullscreen true
}
